        {
          "name": "Paginate Companies - 200",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json", "type": "text" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/companies?page=1&per_page=15",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "companies"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "per_page", "value": "15" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "var body = pm.response.json();",
                  "pm.test('Laravel pagination shape', function () {",
                  "  pm.expect(body).to.have.property('data');",
                  "  pm.expect(body).to.have.property('links');",
                  "  pm.expect(body).to.have.property('meta');",
                  "});"
                ]
              }
            }
          ]
        },
