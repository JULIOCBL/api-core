  "item": [
    {
      "name": "Companies",
      "item": [
        {
          "name": "Create Company - 201",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Go Flores SA\",\n  \"commercial_name\": \"Go Flores\",\n  \"bussiness_name\": \"Go Flores SA de CV\",\n  \"rfc\": \"XAXX010101000\",\n  \"contact_phone\": \"9991234567\",\n  \"email\": \"contacto@goflores.com\",\n  \"primary_color\": \"#0A84FF\",\n  \"secondary_color\": \"#111111\",\n  \"tertiary_color\": \"#FFFFFF\",\n  \"image_logo\": \"https://cdn.example.com/logo.png\",\n  \"status\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/companies",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "companies"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "var body = pm.response.json();",
                  "pm.test('Response has data', function () { pm.expect(body).to.have.property('data'); });",
                  "pm.test('Response has message object', function () { pm.expect(body).to.have.property('message'); pm.expect(body.message).to.have.property('title'); pm.expect(body.message).to.have.property('description'); });"
                ]
              }
            }
          ]
        },
